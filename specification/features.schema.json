{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abmex.dev/spec/features.schema.json",
  "title": "abmex specification feature registry",
  "type": "object",
  "required": ["version", "prototype", "features", "layers"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "prototype": { "type": "string" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "scope", "status", "check", "landedLayer"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^CF-\\d{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "scope": { "type": "string" },
          "flag": { "type": "string" },
          "status": { "enum": ["proposed", "agreed", "final"] },
          "check": { "type": "string", "pattern": "^checks/" },
          "landedLayer": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "title", "features"],
        "additionalProperties": true,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string", "pattern": "^CF-\\d{2}$" } },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "regression": { "type": "array", "items": { "type": "string", "pattern": "^CF-\\d{2}$" } },
          "exempt": { "type": "array", "items": { "type": "string", "pattern": "^CF-\\d{2}$" } }
        }
      }
    }
  }
}
