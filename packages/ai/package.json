{
  "name": "@abmex/ai",
  "version": "0.1.0-next.0",
  "description": "Durable AI-chat persistence: per-origin append-only event log in IndexedDB, WAL-acked local gateway (SQLite/Postgres), fold-on-read projections, one-way replication idempotent by (origin, seq).",
  "type": "module",
  "private": false,
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "abmex-ai-gateway": "./dist/gateway/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "node": "./dist/gateway/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --environment node",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm build && pnpm lint:pkg",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "hono": "4.13.13",
    "idb": "8.0.4",
    "valibot": "1.5.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "better-sqlite3": "^13.0.0",
    "pg": "^8.0.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.0.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "better-sqlite3": "13.0.3",
    "fake-indexeddb": "6.2.6",
    "pg": "8.23.1",
    "publint": "0.3.25",
    "react": "19.2.6",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zautke/abmex-design-system.git",
    "directory": "packages/ai"
  }
}
