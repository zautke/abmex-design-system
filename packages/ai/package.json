{
  "name": "@abmex/ai",
  "version": "0.1.0-next.0",
  "description": "Durable AI-chat persistence: per-origin append-only event log, WAL-acked local gateway, fold-on-read projections. Schemas, config and the pure stream fold live at the root; browser client, React hooks and the Node gateway are subpath entries.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --environment node",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "check": "pnpm typecheck && pnpm build && pnpm lint:pkg",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zautke/abmex-design-system.git",
    "directory": "packages/ai"
  }
}
