{
  "name": "@merlyn/ui",
  "version": "0.1.0",
  "description": "Reusable React UI components extracted from Merlyn (WXT MV3 extension).",
  "type": "module",
  "private": false,
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "engines": {
    "node": ">=18"
  },
  "files": ["dist", "README.md", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && cp src/styles/tailwind.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "lucide-react": "^0.575.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "react-colorful": "^5.6.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
