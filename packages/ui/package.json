{
  "name": "@abmex/ui",
  "version": "0.7.0-next.2",
  "description": "Reusable React AI-chat UI components on HeroUI v3 — presentation only, extracted from Merlyn (WXT MV3 extension).",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zautke/abmex-design-system.git",
    "directory": "packages/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js"
    },
    "./tabs/sortable": {
      "types": "./dist/components/tabs/Sortable.d.ts",
      "import": "./dist/components/tabs/Sortable.js"
    },
    "./button-group": {
      "types": "./dist/components/button-group/index.d.ts",
      "import": "./dist/components/button-group/index.js"
    },
    "./theme-toggle": {
      "types": "./dist/components/theme-toggle/index.d.ts",
      "import": "./dist/components/theme-toggle/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./phosphor/*": "./dist/phosphor/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": ">=8.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "dependencies": {
    "@abmex/themes": "workspace:^",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "react-colorful": "5.7.0",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "lucide-react": "0.575.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "typescript": "5.9.3",
    "vite": "7.3.3",
    "vite-plugin-dts": "4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
